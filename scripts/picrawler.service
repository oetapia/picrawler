[Unit]
Description=PiCrawler Robot Service
Documentation=https://github.com/oetapia/picrawler
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/picrawler
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/picrawler/venv/bin/python /home/pi/picrawler/manual_control/startup.py

# Restart policy
Restart=on-failure
RestartSec=10

# Give it time to gracefully shut down
TimeoutStopSec=30

# Standard output and error go to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=picrawler

# Hardware access permissions
SupplementaryGroups=gpio i2c spi video audio

[Install]
WantedBy=multi-user.target
